# EditorConfig helps maintain consistent coding styles across different editors and IDEs
# Visit https://editorconfig.org for more information

# Top-most EditorConfig file
root = true

#-------------------- Universal Settings --------------------#
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

#-------------------- Terraform / HCL --------------------#
[*.{tf,tfvars,hcl}]
indent_style = space
indent_size = 2
max_line_length = 120

#-------------------- Python --------------------#
[*.py]
indent_style = space
indent_size = 4
max_line_length = 88  # Black formatter default

[*.{pyi}]
indent_style = space
indent_size = 4

#-------------------- JSON --------------------#
[*.json]
indent_style = space
indent_size = 2

[*.json5]
indent_style = space
indent_size = 2

#-------------------- YAML --------------------#
[*.{yml,yaml}]
indent_style = space
indent_size = 2

#-------------------- Markdown --------------------#
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false  # Preserve trailing spaces for line breaks
max_line_length = 100

#-------------------- Shell Scripts --------------------#
[*.{sh,bash}]
indent_style = space
indent_size = 2
end_of_line = lf

[*.ps1]
indent_style = space
indent_size = 2

#-------------------- JavaScript / TypeScript (for future frontend) --------------------#
[*.{js,jsx,ts,tsx}]
indent_style = space
indent_size = 2

#-------------------- HTML / CSS --------------------#
[*.{html,css,scss,sass}]
indent_style = space
indent_size = 2

#-------------------- Configuration Files --------------------#
[{package.json,.prettierrc,.eslintrc,.babelrc}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab

[*.toml]
indent_style = space
indent_size = 2

#-------------------- ASL (Step Functions State Machine) --------------------#
[*.asl.json]
indent_style = space
indent_size = 2

#-------------------- Special Files --------------------#
[{*.txt,LICENSE,README}]
indent_style = space
indent_size = 2
